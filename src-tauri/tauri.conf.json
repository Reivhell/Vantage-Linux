{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vantage Linux",
  "version": "0.1.0",
  "identifier": "com.github.vantagelinux",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vantage Linux",
        "width": 1280,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
